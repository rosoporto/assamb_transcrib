# Ключ из https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=PASTE_YOUR_KEY_HERE

# Необязательно: тариф $/час для оценки расходов (API стоимость не отдаёт).
# По умолчанию 0.21 — Universal-3.5 Pro; спикеры +0.02, термины +0.05.
# ASSEMBLYAI_PRICE_PER_HOUR=0.21

# Термины для распознавания: по умолчанию вшит список DEFAULT_TERMS (+$0.05/ч).
# Свой список: ASSEMBLYAI_TERMS=Термин1,Термин2
# Отключить: оставить значение пустым.
# ASSEMBLYAI_TERMS=
